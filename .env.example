# Kreathief Environment Variables
# Copy this file to .env.local and fill in the values

# Authentication Mode
# Set to 'true' for development (mock auth)
# Set to 'false' for production (real Supabase auth)
VITE_USE_QA_BYPASS=false

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Dynamic Mockups API (ACCOUNT_ID:SECRET_KEY)
VITE_DYNAMIC_MOCKUPS_API_KEY=your_api_key_here

# Vecteezy API Key
VITE_VECTEEZY_API_KEY=your_vecteezy_api_key_here

# IconScout API
VITE_ICONSCOUT_CLIENT_ID=your_client_id_here
VITE_ICONSCOUT_SECRET_KEY=your_secret_key_here
