# Kreathief Environment Variables
# Copy this file to .env.local and fill in your API keys

# Authentication Mode
# Set to 'true' for local development bypass (mock auth)
# Set to 'false' for production (real Supabase auth)
VITE_USE_QA_BYPASS=false

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenRouter API Key (Unified LLM gateway for text & design intelligence)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Fal.ai API Key (for image generation, FLUX, SDXL & upscaling)
FAL_KEY=your_fal_api_key_here

# Dynamic Mockups API Key (Server-side key for cloud mockup rendering)
DYNAMIC_MOCKUPS_API_KEY=your_dynamic_mockups_api_key_here

# IconScout API Credentials (3D assets & Lottie vector animations)
ICONSCOUT_CLIENT_ID=your_iconscout_client_id_here
ICONSCOUT_SECRET_KEY=your_iconscout_secret_key_here

# Unsplash API Key (Stock photography)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Freepik API Key (Vector graphics & icons)
FREEPIK_API_KEY=your_freepik_api_key_here

# Tenor API Key (Animated GIF stickers)
TENOR_API_KEY=your_tenor_api_key_here

# Sentry Error Tracking
VITE_SENTRY_DSN=your_sentry_dsn_here
